{
  "name": "@altqx/rwss",
  "version": "0.1.4",
  "author": "altqx",
  "license": "MIT",
  "description": "Web browser ASS/SSA renderer wrapper around rassa",
  "repository": "https://github.com/altqx/rwss",
  "keywords": ["rwss", "rassa", "ass", "ssa", "subtitle", "wasm", "rust", "rendering", "video"],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pkg": {
      "types": "./pkg/rwss.d.ts",
      "import": "./pkg/rwss.js",
      "default": "./pkg/rwss.js"
    }
  },
  "files": ["dist", "pkg", "src/wrapper.ts", "src/default.woff2"],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:wasm:release": "wasm-pack build --release --target web --out-dir pkg",
    "build:wasm:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler",
    "build:assets": "mkdir -p dist && cp src/default.woff2 dist/default.woff2",
    "build:ts": "bun x tsc -p tsconfig.json && bun run build:assets",
    "build": "bun run build:wasm:release && bun run build:ts",
    "typecheck": "bun x tsc -p tsconfig.json --pretty false && bun x tsc -p tsconfig.test.json --noEmit --pretty false",
    "test:rust": "cargo test",
    "test:ts": "bun test tests/*.test.ts",
    "test:e2e": "bun test tests/e2e-render.test.ts",
    "test": "bun run test:rust && bun run typecheck && bun run test:ts",
    "clean": "rm -rf pkg pkg-bundler dist target tests/artifacts",
    "format": "cargo fmt"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.71"
  }
}
